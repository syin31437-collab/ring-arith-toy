    23	import collect as C
    24	
    25	C.NODES["claude_sonnet"] = ("claude", "sonnet", None, None)
    26	AGENTS = ["ds_flash_a", "ds_flash_b", "ds_pro_a", "ds_pro_b", "claude_haiku", "codex"]
    27	COORD = "claude_sonnet"
    28	DELTA, BATCHES, PER, START = 0.40, 7, 10, 3
