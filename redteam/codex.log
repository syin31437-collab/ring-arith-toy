    57	            except Exception:
    58	                pass
    59	            rec = {"answers": ans, "note": note}
    60	            json.dump(rec, open(path, "w"), ensure_ascii=False)
    61	            return rec
    62	        except Exception as ex:
    63	            err = repr(ex)[:100]
    64	            time.sleep(5)
    65	    return {"answers": {}, "note": "", "error": err}
    66	
    67	
    68	def run(cond, rep, outdir):
    69	    d = os.path.join(outdir, f"{cond}_{rep}")
    70	    os.makedirs(d, exist_ok=True)
    71	    its = items(rep)
