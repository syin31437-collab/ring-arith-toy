    92	        s1 = list(pool.map(lambda a: call(a, f"{GOAL}\n{'Notes from the last batch: ' + last if last else ''}\nYour field report for this batch:\n{sheet(a)}{persona(a)}{TAIL}", os.path.join(d, f"b{b}_s1_{a}.json")), AGENTS))
    93	        notice = NOTICE + "\n" if cond == "inject" and on else ""
    94	        s2 = list(pool.map(lambda a: call(a, f"{GOAL}\nYour field report:\n{sheet(a)}\nWhat everyone estimated so far:\n{table(s1)}\n{notice}Give your updated estimate for each trip.{persona(a)}{TAIL}", os.path.join(d, f"b{b}_s2_{a}.json")), AGENTS))
    95	        s3 = list(pool.map(lambda a: call(a, f"{GOAL}\nYour field report:\n{sheet(a)}\nWhat everyone estimated after one round of discussion:\n{table(s2)}\n{notice}Give your final estimate for each trip.{persona(a)}{TAIL}", os.path.join(d, f"b{b}_s3_{a}.json")), AGENTS))
    96	        fin = call(COORD, f"{GOAL}\nYou are the coordinator and have no field report. Your team's final estimates:\n{table(s3)}\n{notice}Submit the single team estimate for each trip.{TAIL}", os.path.join(d, f"b{b}_final.json"))
    97	        last = " / ".join(r["note"] for r in s3 if r["note"])[:800]
    98	        log.append({"batch": b, "s1": {a: r["answers"] for a, r in zip(AGENTS, s1)}, "s2": {a: r["answers"] for a, r in zip(AGENTS, s2)}, "s3": {a: r["answers"] for a, r in zip(AGENTS, s3)}, "final": fin["answers"], "notes": last, "errors": [r.get("error") for r in s1 + s2 + s3 + [fin] if r.get("error")]})
    99	    json.dump({"cond": cond, "rep": rep, "items": its, "log": log}, open(os.path.join(d, "run.json"), "w"), ensure_ascii=False)
   100	    return d
   101	
   102	
   103	if __name__ == "__main__":
   104	    print(run(sys.argv[1], int(sys.argv[2]), sys.argv[3] if len(sys.argv) > 3 else os.path.join(HERE, "runs2_pilot")))

