   198	def sigma_c(clean):
   199	    """约束噪声：Var(p − 报告中位数) 扣掉报告中位数自己的方差（对节点 bootstrap 估计），稳健版。"""
   200	    e = [p - r.median().item() for _, p, r, _ in clean]
   201	    g = torch.Generator().manual_seed(0)
   202	    vm = []
   203	    for _, _, r, _ in clean[:200]:
   204	        idx = torch.randint(0, len(r), (200, len(r)), generator=g)
   205	        vm.append(r[idx].median(1).values.var().item())
   206	    tot = mad(e) ** 2
   207	    if tot < 1e-12:                                        # 大量完全相同的值（都凭记忆答了同一个取整数）会把 MAD 压成 0 → 改用平均绝对偏差（高斯等价 × 1.2533）
   208	        me = st.median(e)
   209	        tot = (1.2533 * st.mean(abs(x - me) for x in e)) ** 2
   210	    return st.median(e), math.sqrt(max(tot - st.mean(vm), 0.01 * tot, 1e-18))
