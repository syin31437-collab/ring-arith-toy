    43	def baselines(clean, bad, judge, s0):
    44	    b, _ = sigma_c(clean)
    45	    D = torch.stack([r - r.median() for _, _, r, _ in clean])
    46	    spread = max(st.median(1.4826 * d.abs().median().item() for d in D), 1e-9)
    47	    n = len(clean[0][2])
    48	    sm = math.sqrt(math.pi / 2) * spread / math.sqrt(n)
    49	    s = s0
    50	    if judge == "硬2":
    51	        dev = torch.stack([r - p for _, p, r, _ in clean])
    52	        s = max(s, L._mad(dev).min().item())
    53	    jd = "软" if judge == "软" else "硬"
    54	    b1 = st.mean(2 * (1 - Phi((x / 2) / sm)) for *_, x in bad)
    55	    b2 = st.mean(abs(judge_out(r, torch.tensor(p), s, jd) - (p - b)) > x / 2 for _, p, r, x in bad)
    56	    return b1, b2
