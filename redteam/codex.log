   112	def interval2(clean, bad, judge, B=50):
   113	    s0 = max(sigma_c(clean)[1], 1e-6)
   114	    rows = [(False, p, r, x) for _, p, r, x in clean] + bad
   115	    point = derive5(rows, judge, s0)
   116	    bs = []
   117	    for bt in range(B):
   118	        rg = random.Random(bt)
   119	        cl = [rg.choice(clean) for _ in clean]
   120	        bd = [rg.choice(bad) for _ in bad]
   121	        bs.append(derive5([(False, p, r, x) for _, p, r, x in cl] + bd, judge, s0))      # 裁判固定
   122	    bs.sort()
   123	    e = 1.645 * math.sqrt(max(point * (1 - point), 1e-4) / len(bad))
   124	    lo, hi = bs[int(0.05 * B)], bs[int(0.95 * B) - 1]
   125	    rh, off = rho_hat2(clean, bad)
   126	    if rh < 1:
   127	        v, idx = torch.sort(off.abs())
   128	        k = int(torch.argmax(v[1:] - v[:-1])) + 1 if len(v) > 1 else 1
   129	        A = torch.zeros(len(off), dtype=torch.bool)
   130	        A[idx[:k]] = True
   131	        for honest in (A, ~A):
   132	            if honest.any():
   133	                q = derive5(rows, judge, s0, honest=honest)
   134	                lo, hi = min(lo, q), max(hi, q)
   135	    return point, max(0.0, lo - e), min(1.0, hi + e), s0, rh, 2 * e
