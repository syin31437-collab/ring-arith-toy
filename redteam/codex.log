    86	def soft_all(R, p, s):
    87	    """软裁判对所有坐标批量算（和 hetero.judge_out 的软裁判同一定义）：R (n, D)、p (D,)。"""
    88	    w = torch.exp(-((R - p) ** 2) / (2 * s ** 2)) + 1e-6
    89	    v, o = torch.sort(R, 0)
    90	    cw = torch.cumsum(torch.gather(w, 0, o), 0)
    91	    j = (cw >= cw[-1] / 2).float().argmax(0)
    92	    return v[j, torch.arange(R.shape[1])]
