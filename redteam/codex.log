   106	def rho_hat2(clean, bad):
   107	    b, sc = sigma_c(clean)
   108	    Y = torch.stack([r - (p - b) for _, p, r, _ in bad])
   109	    return Y.median(0).values.abs().max().item() / max(sc, 1e-9), Y.median(0).values
