   121	def natural():
   122	    """域 2：每格 (拒答?, 实测, 点预测)。"""
   123	    import oslo as O
   124	    import epa as E
   125	    H = math.log10(1.25)
   126	    out = []
   127	    D = O.load()
   128	    us = O.present(D, [39, 40])
   129	    for wc, we in ((38, 39), (39, 40), (40, 41)):
   130	        rc, re = O.rows(D, [wc], us), O.rows(D, [we], us)
   131	        if len(rc) < 48 or len(re) < 48:
   132	            continue
   133	        off = torch.stack([r for _, _, r in O.rows(D, [36, 37], us)]).median(0).values if O.rows(D, [36, 37], us) else 0
   134	        cal = [(False, p, r - off, 2 * H) for _, p, r in rc]
   135	        ev = [(True, p, r - off, 2 * H) for _, p, r in re]
   136	        ref = L.premise_check(cal, ev, [h[:10] for h, _, _ in rc], [h[:10] for h, _, _ in re], H)
   137	        s0 = max(sigma_c(cal)[1], 1e-6)
   138	        out.append({"src": f"Oslo w{wc}", "refuse": ref[0], "act": measure(cal + ev, 2 * H, "软", s0)["miss"], "pt": L.predict(cal, ev, "软", s0)})
   139	    S, Ref, _ = E.load()
   140	    NODES, SC = ["AQY", "CNO", "MAX", "PAR"], "RAM"
   141	    for loc in sorted(S):
   142	        ts = sorted(S[loc])
   143	        t0 = dt.datetime.fromisoformat(ts[0])
   144	        rows = []
   145	        for t in ts:
   146	            v = S[loc][t]
   147	            if Ref[loc].get(t, 0) >= 3 and all(m in v and st.median(v[m]) > 0 for m in NODES + [SC]):
   148	                tru = math.log10(Ref[loc][t])
   149	                rows.append(((dt.datetime.fromisoformat(t) - t0).days, t[:10], math.log10(st.median(v[SC])) - tru, torch.tensor([math.log10(st.median(v[m])) - tru for m in NODES])))
   150	        sb = [x for x in rows if x[0] < 90]
   151	        if len(sb) < 200:
   152	            continue
   153	        off = torch.stack([x[3] for x in sb]).median(0).values
   154	        off_s = st.median(x[2] for x in sb)
   155	        for w in range(90, rows[-1][0] - 14, 28):
   156	            rc = [x for x in rows if w <= x[0] < w + 7]
   157	            re = [x for x in rows if w + 7 <= x[0] < w + 14]
   158	            if len(rc) < 48 or len(re) < 48:
   159	                continue
   160	            cal = [(False, x[2] - off_s, x[3] - off, 2 * H) for x in rc]
   161	            ev = [(True, x[2] - off_s, x[3] - off, 2 * H) for x in re]
   162	            ref = L.premise_check(cal, ev, [x[1] for x in rc], [x[1] for x in re], H)
   163	            s0 = max(sigma_c(cal)[1], 1e-6)
   164	            out.append({"src": f"EPA {loc} d{w}", "refuse": ref[0], "act": measure(cal + ev, 2 * H, "软", s0)["miss"], "pt": L.predict(cal, ev, "软", s0)})
   165	    return out
