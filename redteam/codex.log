   255	    X = torch.stack([r - (p - b) for _, p, r, _ in rows])                      # 全部题目，不分故障与否
   256	    se = X.std(0) / math.sqrt(len(rows))
   257	    w = torch.exp(-0.5 * (X.mean(0) / se.clamp(min=1e-12)) ** 2)
