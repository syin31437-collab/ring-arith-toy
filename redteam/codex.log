    78	def grads(W, X, Y):
    79	    """逐样本梯度 (b, 7850)：线性 softmax 的交叉熵。"""
    80	    Xb = torch.cat([X, torch.ones(len(X), 1)], 1)
    81	    P = torch.softmax(Xb @ W, 1)
    82	    P[torch.arange(len(Y)), Y] -= 1
    83	    return (Xb.unsqueeze(2) * P.unsqueeze(1)).reshape(len(X), -1)
