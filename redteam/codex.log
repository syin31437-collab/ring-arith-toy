    46	    vi = (math.pi / 2) * _loo(R).median().item() ** 2 / k if k >= 3 else 0.0
    47	    c = R.median(1).values.tolist()
    48	    keys, idx = _groups(blocks, len(c))
    49	    rg = random.Random(0)
    50	    bs = []
    51	    for _ in range(B):
    52	        ii = [i for _ in keys for i in idx[rg.choice(keys)]]
    53	        bs.append(_hat([c[i] for i in ii], [a[i] for i in ii], [b[i] for i in ii]) - vi)
    54	    bs.sort()
    55	    return bs[int(0.05 * B)] > (h / 2) ** 2, math.sqrt(max(_hat(c, a, b) - vi, 0.0))
    56	
    57	
    58	def scale_broke(ab_c, ab_e, h, bc=None, be=None, B=200):
    59	    def med_block(v, bl):
    60	        keys, idx = _groups(bl, len(v))
    61	        return [st.median(v[i] for i in idx[k]) for k in keys]
    62	    mc, me = med_block(ab_c, bc), med_block(ab_e, be)
    63	    sh = st.median(me) - st.median(mc)
    64	    mad1 = lambda xs: 1.4826 * st.median(abs(x - st.median(xs)) for x in xs)
    65	    se = 1.2533 * math.sqrt(mad1(mc) ** 2 / max(len(mc), 1) + mad1(me) ** 2 / max(len(me), 1))
    66	    k_c, i_c = _groups(bc, len(ab_c))
    67	    k_e, i_e = _groups(be, len(ab_e))
    68	    rg = random.Random(1)
    69	    bs = []
    70	    for _ in range(B):
    71	        vc = [ab_c[i] for _ in k_c for i in i_c[rg.choice(k_c)]]
    72	        ve = [ab_e[i] for _ in k_e for i in i_e[rg.choice(k_e)]]
    73	        bs.append(_m2(ve) - _m2(vc))
    74	    bs.sort()
    75	    return (abs(sh) > 2 * se and abs(sh) > h / 2) or bs[int(0.05 * B)] > (h / 2) ** 2
    76	
    77	
    78	def decide(clean, bad, b_c, b_e, h, bc=None, be=None):
    79	    """返回 dict：refuse（总判定）、n1_cal、n1_ev、s1、m1、sigma_cm。b_c / b_e = 第二把秤（相对同一真值）。"""
    80	    F = fit(clean, bad)
    81	    keep = F["ph"] >= 0.5
    82	    if keep.sum() < 2:
    83	        keep = torch.ones_like(keep)
    84	    Rc, Re = torch.stack([r for _, _, r, _ in clean]), torch.stack([r for _, _, r, _ in bad])
    85	    ac, ae = [p for _, p, _, _ in clean], [p for _, p, _, _ in bad]
    86	    n1c, s0 = common(Rc, ac, b_c, h, bc)
    87	    n1e, s1v = common(Re[:, keep], ae, b_e, h, be)
    88	    s1 = scale_broke([x - y for x, y in zip(ac, b_c)], [x - y for x, y in zip(ae, b_e)], h, bc, be)
    89	    m1 = premise_check(clean, bad, bc if bc is not None else list(range(len(clean))), be if be is not None else list(range(len(bad))), h)[0]
    90	    return {"refuse": n1c or n1e or s1 or m1, "n1_cal": n1c, "n1_ev": n1e, "s1": s1, "m1": m1, "sigma_cm": max(s0, s1v), "k_keep": int(keep.sum())}
    91	
    92	
    93	# ===== 敏感度版（v6.2 的前提自检）：不再问"共有误差大不大"，直接问"第二把秤的信息会不会改变预测"。=====
    94	TAU = 0.15                                                               # 容忍的预测变动（预测误差 > 0.15 视为不可用，所有报告里同一口径）
    95	
    96	
    97	def _q(F, rows_p, rows_o, s, jd, extra=0.0):
    98	    """后验用 rows_p 里的秤（F 对应这把秤），裁判输出用 rows_o 里的秤（实际部署的那把）。extra = 加到后验方差上的共有误差方差。"""
    99	    from analytic import Phi
   100	    from hetero import judge_out
   101	    from law_v6 import subsets
   102	    S = subsets(F["ph"])
   103	    P = S @ F["prec"] + 1 / F["vc"]
   104	    sd = torch.sqrt(1 / P + extra)
   105	    out = []
   106	    for (_, pp, r, dk), (_, po, _, _) in zip(rows_p, rows_o):
   107	        o, t = judge_out(r, torch.tensor(po), s, jd), dk / 2
   108	        m = (S @ (F["prec"] * r) + (pp - F["b"]) / F["vc"]) / P
   109	        out.append(st.mean(1 - (Phi((t - (o - mi)) / si) - Phi((-t - (o - mi)) / si)) for mi, si in zip(m.tolist(), sd.tolist())))
   110	    return st.mean(out)
   111	
   112	
   113	def _cm_lower(R, a, b, blocks, B=200):
   114	    k = R.shape[1]
   115	    vi = (math.pi / 2) * _loo(R).median().item() ** 2 / k if k >= 3 else 0.0
   116	    c = R.median(1).values.tolist()
   117	    keys, idx = _groups(blocks, len(c))
   118	    rg = random.Random(0)
   119	    bs = []
   120	    for _ in range(B):
   121	        ii = [i for _ in keys for i in idx[rg.choice(keys)]]
   122	        bs.append(_hat([c[i] for i in ii], [a[i] for i in ii], [b[i] for i in ii]) - vi)
   123	    bs.sort()
   124	    return max(bs[int(0.05 * B)], 0.0)
