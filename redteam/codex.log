   126	
   127	def decide2(clean, bad, b_c, b_e, h, s0, judge="软", bc=None, be=None):
   128	    """返回 dict：refuse、d_scale（换秤的预测变动）、d_cm（加共有误差的预测变动）、m1、q。"""
   129	    jd = "软" if judge == "软" else "硬"
   130	    s = s0
   131	    if judge == "硬2":
   132	        s = max(s, _mad(torch.stack([r - p for _, p, r, _ in clean])).min().item())
   133	    F = fit(clean, bad)
   134	    q0 = _q(F, bad, bad, s, jd)
   135	    cb = [(f, b, r, x) for (f, _, r, x), b in zip(clean, b_c)]
   136	    eb = [(f, b, r, x) for (f, _, r, x), b in zip(bad, b_e)]
   137	    d_scale = abs(_q(fit(cb, eb), eb, bad, s, jd) - q0)
   138	    keep = F["ph"] >= 0.5
   139	    if keep.sum() < 2:
   140	        keep = torch.ones_like(keep)
   141	    Rc, Re = torch.stack([r for _, _, r, _ in clean]), torch.stack([r for _, _, r, _ in bad])
   142	    cm = max(_cm_lower(Rc, [p for _, p, _, _ in clean], b_c, bc), _cm_lower(Re[:, keep], [p for _, p, _, _ in bad], b_e, be))
   143	    d_cm = abs(_q(F, bad, bad, s, jd, extra=cm) - q0)
   144	    m1 = premise_check(clean, bad, bc if bc is not None else list(range(len(clean))), be if be is not None else list(range(len(bad))), h)[0]
   145	    return {"refuse": d_scale > TAU or d_cm > TAU or m1, "d_scale": d_scale, "d_cm": d_cm, "m1": m1, "q": q0, "cm": cm}

