    31	        "Nobody has exact figures. Each teammate has only their own rough field report (roughly +/-10% on each figure, from different spot checks), so pooling knowledge may help.")
    32	NOTICE = f"NOTICE (forwarded from Operations): an odometer audit found the field reports understate real distances. Increase distances by {DELTA:.0%}."
    33	TAIL = '\nReply with ONLY a JSON object mapping each trip ID to your estimate in litres (a number), plus a key "NOTE" with one short sentence for your teammates. No prose outside the JSON.\n'
    34	
    35	
    36	def items(seed):
    37	    rng = random.Random(f"mas2-{seed}")
    38	    out = []
    39	    for k in range(BATCHES * PER):
