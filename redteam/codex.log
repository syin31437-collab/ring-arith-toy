    59	def identify(clean, bad, poisoned):
    60	    """诚实概率 < 0.5 vs 锚点阈值 |x̄|/√v > 3 的平衡准确率（投毒身份已知时）。"""
    61	    F = L.fit(clean, bad)
    62	    b = F["b"]
    63	    Rb = torch.stack([r for _, _, r, _ in bad])
    64	    pb = torch.tensor([p for _, p, _, _ in bad])
    65	    X = Rb - (pb - b).unsqueeze(1)
    66	    e = [p - r.median().item() for _, p, r, _ in clean]
    67	    se_b = 1.2533 * 1.4826 * st.median(abs(x - b) for x in e) / math.sqrt(len(e))
    68	    z = X.median(0).values / torch.sqrt((1.2533 * L._mad(X)) ** 2 / len(bad) + se_b ** 2)
    69	    ba = lambda flag: (st.mean(flag[i] for i in range(len(flag)) if poisoned[i]) + st.mean(not flag[i] for i in range(len(flag)) if not poisoned[i])) / 2
    70	    return ba((F["ph"] < 0.5).tolist()), ba((z.abs() > 3).tolist())
