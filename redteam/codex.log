    59	def groups():
    60	    labs = B.all_labs()
    61	    ep = [t for t in sorted({t for d in labs.values() for t in d}) if 55564 <= t < B.SANDBOX_END]
    62	    good = sorted(k for k, d in labs.items() if len(B.diffs(d, ep)) >= 0.97 * len(ep))
    63	    random.Random("bipm-groups").shuffle(good)
    64	    return labs, [good[i:i + 9] for i in range(0, len(good) - 8, 9)][:4]
    65	
    66	
    67	def windows(mode):
    68	    lo, hi = (55564, B.SANDBOX_END) if mode == "sandbox" else (B.SANDBOX_END, 10 ** 6)
    69	    labs, G = groups()
    70	    gps, glo = B.gnss("gps"), B.gnss("glo")
    71	    epochs = [t for t in sorted({t for d in labs.values() for t in d}) if lo <= t < hi]
    72	    pg, pl = B.diffs(gps, epochs), B.diffs(glo, epochs)
    73	    for gi, g in enumerate(G):
    74	        D = [B.diffs(labs[k], epochs) for k in g]
    75	        for w in range(0, len(epochs) - 129, 130):
    76	            cut = epochs[w:w + 130]
    77	            rows = [(t, pg[t], pl[t], torch.tensor([d[t] for d in D])) for t in cut if t in pg and t in pl and all(t in d for d in D)]
    78	            cal = [x for x in rows if x[0] < cut[104]]
    79	            ev = [x for x in rows if x[0] >= cut[104]]
    80	            if len(cal) >= 50 and len(ev) >= 15:
    81	                yield gi, w, cal, ev
    82	
    83	
    84	def one(tag, cal, ev, h, shift=None, zeta=0.0, judges=("软", "硬2")):
    85	    """shift = 节点的注入向量；zeta = 秤 A 在评估期的注入。"""
    86	    sh = shift if shift is not None else torch.zeros(len(cal[0][3]))
    87	    c = [(False, a, r, 2 * h) for _, a, _, r in cal]
    88	    e = [(True, a + zeta, r + sh, 2 * h) for _, a, _, r in ev]
    89	    prem = decide(c, e, [b for _, _, b, _ in cal], [b for _, _, b, _ in ev], h)
    90	    out, items = [], []
    91	    for judge in judges:
    92	        pt, lo, hi, s0, rh = L.interval(c, e, judge, B=20)
    93	        act = measure(c + e, 2 * h, judge, s0)["miss"]
    94	        b1, b2 = baselines(c, e, judge, s0)
    95	        d5 = derive5(c + e, judge, s0)
    96	        q, parts, _ = L.item_probs(c, e, judge, s0)
    97	        for qi, (o, m, sd, t) in zip(q, parts):
    98	            items.append((qi, abs(o) > t, st.mean(Phi(x) for x in ((0 - m) / sd).tolist())))
    99	        out.append({"tag": tag, "judge": judge, "h": h, "act": act, "pt": pt, "lo": lo, "hi": hi, "rho": rh, "refuse": prem["refuse"], "d5": d5, "b1": b1, "b2": b2, "s1": prem["s1"], "m1": prem["m1"]})
   100	    return out, items
   101	
   102	
   103	def main(mode):
   104	    R, items, ids, Bv, Sv = [], [], [], [], []
   105	    rng = random.Random("bipm-inject")
   106	    n_w = 0
   107	    for gi, w, cal, ev in windows(mode):
   108	        n_w += 1
   109	        for h in (1.5, 3.0):
   110	            o, it = one("自然", cal, ev, h)
   111	            R += o; items += it
   112	        for k, dl in itertools.product((2, 4, 6), (3.0, 6.0, 12.0)):
   113	            idx = rng.sample(range(9), k)
   114	            sh = torch.zeros(9); sh[idx] = dl
   115	            o, it = one("注入", cal, ev, dl / 2, sh)
   116	            R += o; items += it
   117	            pois = [i in idx for i in range(9)]
   118	            c = [(False, a, r, dl) for _, a, _, r in cal]
   119	            e = [(True, a, r + sh, dl) for _, a, _, r in ev]
   120	            ids.append(identify(c, e, pois))
   121	        for dl in (6.0, 12.0):
   122	            o, _ = one("B", cal, ev, dl / 2, torch.full((9,), dl), judges=("软",))
   123	            Bv += o
   124	            idx = rng.sample(range(9), 4)
   125	            sh = torch.zeros(9); sh[idx] = dl
   126	            o, _ = one("S", cal, ev, dl / 2, sh, zeta=dl, judges=("软",))
   127	            Sv += o
   128	        print(f"组 {gi} 窗 {w} 完成（校准 {len(cal)}、评估 {len(ev)}）", flush=True)
   129	    json.dump({"law": L.LAW_VERSION, "cells": R, "B": Bv, "S": Sv, "ids": ids, "items": items}, open(os.path.join(HERE, f"validate_bipm_{mode}.json"), "w"), ensure_ascii=False)
   130	    rk = lambda v: torch.tensor(v, dtype=torch.float).argsort().argsort().float()
   131	    act = [r["act"] for r in R]
   132	    mae = lambda k, s=R: st.mean(abs(r[k] - r["act"]) for r in s)
   133	    sp = lambda k: torch.corrcoef(torch.stack([rk([r[k] for r in R]), rk(act)]))[0, 1].item()
   134	    print(f"\n规律 {L.LAW_VERSION}；{mode}：{n_w} 个窗口-组，{len(R)} 格，实测被骗均值 {st.mean(act):.3f}")
   135	    print(f"1. MAE {mae('pt'):.3f}（≤ 0.10）；点误差中位 {st.median(abs(r['pt'] - r['act']) for r in R):.3f}；Spearman {sp('pt'):.2f}（≥ 0.80）")
   136	    for t in ("自然", "注入"):
   137	        s = [r for r in R if r["tag"] == t]
   138	        print(f"   {t}：{len(s)} 格，实测 {st.mean(r['act'] for r in s):.3f}，预测 {st.mean(r['pt'] for r in s):.3f}，MAE {mae('pt', s):.3f}，B2 {mae('b2', s):.3f}")
   139	    bins = [[] for _ in range(10)]
   140	    for q, y, _ in items:
   141	        bins[min(int(q * 10), 9)].append((q, y))
   142	    ece = sum(len(b) * abs(st.mean(x[0] for x in b) - st.mean(x[1] for x in b)) for b in bins if b) / len(items)
   143	    print(f"2. ECE {ece:.3f}（≤ 0.05）；Brier {st.mean((q - y) ** 2 for q, y, _ in items):.3f}；后验 90% 区间覆盖 {st.mean(.05 <= p <= .95 for _, _, p in items):.0%}（80–97%）")
   144	    print("   校准表：" + "  ".join(f"{st.mean(x[0] for x in b):.2f}→{st.mean(x[1] for x in b):.2f}" for b in bins if b))
   145	    print(f"3. 区间覆盖 {st.mean(r['lo'] <= r['act'] <= r['hi'] for r in R):.0%}（≥ 90%）；宽度中位 {st.median(r['hi'] - r['lo'] for r in R):.2f}（≤ 0.50）")
   146	    print(f"4a. 前提成立误拒 {st.mean(r['refuse'] for r in R):.0%}（≤ 5%）")
   147	    print(f"4b. B 不成立拒答 {st.mean(r['refuse'] for r in Bv):.0%}（≥ 80%）；预测 MAE {mae('pt', Bv):.3f}")
   148	    print(f"4c. S 不成立拒答 {st.mean(r['refuse'] for r in Sv):.0%}（≥ 80%）；S1 触发 {st.mean(r['s1'] for r in Sv):.0%}；预测 MAE {mae('pt', Sv):.3f}（实测 {st.mean(r['act'] for r in Sv):.2f}、预测 {st.mean(r['pt'] for r in Sv):.2f}）")
   149	    print(f"5. MAE：v6.1 {mae('pt'):.3f} vs derive5 {mae('d5'):.3f}、B1 {mae('b1'):.3f}、B2 {mae('b2'):.3f}；Spearman：derive5 {sp('d5'):.2f}、B1 {sp('b1'):.2f}、B2 {sp('b2'):.2f}")
