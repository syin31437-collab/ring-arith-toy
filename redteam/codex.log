    57	def shift_of(key, s, zeta):
    58	    kind, j = key
    59	    if kind == "peer":
    60	        return s[j] - st.median(s[:j] + s[j + 1:])
    61	    if kind == "nodeA":
    62	        return s[j] - zeta
    63	    if kind == "consA":
    64	        return st.median(s) - zeta
    65	    if kind == "consB":
    66	        return st.median(s)
    67	    return zeta
