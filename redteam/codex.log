    81	            j = lambda x: x * math.exp(0.10 * rng.gauss(0, 1))
    82	            f = (1 + DELTA) if on and a in BAD[cond] else 1.0
    83	            return "\n".join(f"{it['id']}: distance about {j(it['km'] * f):.0f} km, consumption about {j(it['lpk']):.1f} L/100km" for it in batch)
    84	
    85	        def persona(a):
